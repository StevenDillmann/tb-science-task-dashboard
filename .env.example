# Portkey credentials for running Claude Code via Harbor.
# Copy to .env (gitignored) and fill in your real key:
#     cp .env.example .env
# Then run:
#     harbor run -c harbor-portkey.yaml --env-file .env

# Portkey API key — Portkey dashboard → API Keys.
PORTKEY_API_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Portkey's Anthropic-compatible endpoint. No /v1 suffix.
# The claude-code adapter reads this straight from the process environment.
ANTHROPIC_BASE_URL=https://api.portkey.ai

# Portkey routing headers, newline-separated (Claude Code's ANTHROPIC_CUSTOM_HEADERS
# format). Portkey authenticates off x-portkey-api-key and routes to the provider
# whose slug is given by x-portkey-provider — here the Anthropic provider "anthropic".
# ${PORTKEY_API_KEY} is expanded by python-dotenv when the file is loaded.
PORTKEY_HEADERS="x-portkey-api-key: ${PORTKEY_API_KEY}
x-portkey-provider: @anthropic"
